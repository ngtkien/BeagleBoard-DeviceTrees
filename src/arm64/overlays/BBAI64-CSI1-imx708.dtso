// SPDX-License-Identifier: GPL-2.0-only
/*
 * DT Overlay for Sony IMX708 Camera interfaced with CSI1 on BBAI64 board.
 * Based on BBAI64-CSI0-imx219.dtso
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/k3-pinctrl.h>

/* CSI1 */
/* V25_CSI1_GPIO1 */
/* W24_CSI1_GPIO2 */
/* Y6_I2C1_SCL */
/* AA6_I2C1_SDA */

/*
 * Helper to show loaded overlays under: /proc/device-tree/chosen/overlays/
 */
&{/chosen} {
    overlays {
        k3-j721e-beagleboneai64-csi1-imx708.kernel = __TIMESTAMP__;
    };
};

/ {
    fragment@101 {
        target-path = "/";

        __overlay__ {
            clk_csi1_imx708_fixed: csi1-imx708-xclk {
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>;
            };
        };
    };
};

&main_pmx0 {
    main_i2c1_pins_default: main-i2c1-pins-default {
        pinctrl-single,pins = <
            J721E_IOPAD(0x208, PIN_INPUT_PULLUP, 0) /* (Y6) I2C1_SCL */
            J721E_IOPAD(0x20c, PIN_INPUT_PULLUP, 0) /* (AA6) I2C1_SDA */
        >;
    };

    csi1_imx708_gpio_pins: csi1-imx708-gpio-pins {
        pinctrl-single,pins = <
            J721E_IOPAD(0x1bc, PIN_OUTPUT, 7) /* (V25) MDIO0_MDIO.GPIO0_110 */
            //J721E_IOPAD(0x1c0, PIN_OUTPUT, 7) /* (W24) MDIO0_MDC.GPIO0_111 */
        >;
    };
};

&main_i2c1 {
    pinctrl-names = "default";
    pinctrl-0 = <&main_i2c1_pins_default>;
    clock-frequency = <400000>;
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    csi1_imx708: csi1_sensor@1a {
        status = "okay";
        compatible = "sony,imx708";
        reg = <0x1a>;

        clocks = <&clk_csi1_imx708_fixed>;
        clock-names = "xclk";

        pinctrl-names = "default";
        pinctrl-0 = <&csi1_imx708_gpio_pins>;
        reset-gpios = <&main_gpio0 110 GPIO_ACTIVE_HIGH>;

        port {
            csi2rx1_cam1: endpoint {
                remote-endpoint = <&csi2rx1_in_sensor>;
                link-frequencies = /bits/ 64 <450000000>;
                clock-lanes = <0>;
                data-lanes = <1 2>;
            };
        };
    };
};

&csi1_port0 {
    status = "okay";

    csi2rx1_in_sensor: endpoint {
        remote-endpoint = <&csi2rx1_cam1>;
        bus-type = <4>; /* CSI2 DPHY. */
        clock-lanes = <0>;
        data-lanes = <1 2>;
    };
};

&ti_csi2rx1 {
    status = "okay";
};

&cdns_csi2rx1 {
    status = "okay";
};

&dphy1 {
    status = "okay";
};